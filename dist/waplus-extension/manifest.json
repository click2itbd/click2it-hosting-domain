{
  "manifest_version": 3,
  "name": "WAPlus: WhatsApp CRM for Hosting & Domain Portals",
  "version": "1.0.0",
  "description": "Connect WhatsApp Web directly with InHostBilling & Click2IT Hosting Portal. Multi-agent CRM, lead sync, WHMCS account lookup, and quick canned hosting replies.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "http://localhost:3000/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "WAPlus Hosting CRM"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
