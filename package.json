{
  "name": "click2it-hosting-domain",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "dev:frontend": "vite",
    "dev:backend": "tsx backend/src/server.ts",
    "build": "node --max-old-space-size=4096 node_modules/vite/bin/vite.js build && node scripts/sync-cpanel-build.js && npm run build:backend",
    "build:backend": "npx tsc -p backend/tsconfig.json && node -e \"const fs=require('fs');fs.rmSync('backend/compiled',{recursive:true,force:true});fs.cpSync('backend/dist','backend/compiled',{recursive:true});\"",
    "build:all": "npm run build",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc --noEmit",
    "predeploy:check": "node scripts/check-deploy-safety.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:all": "npm run test && npm run build"
  },
  "dependencies": {
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@google/genai": "^1.29.0",
    "@sentry/react": "^11.0.0",
    "@sentry/tracing": "^7.120.4",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.14",
    "dotenv": "^17.3.1",
    "express": "^4.22.1",
    "express-rate-limit": "^8.6.2",
    "file-saver": "^2.0.5",
    "firebase": "^12.11.0",
    "firebase-admin": "^14.3.0",
    "framer-motion": "^12.38.0",
    "helmet": "^8.3.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.2",
    "react": "^19.0.0",
    "react-circular-progressbar": "^2.2.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^3.0.0",
    "react-hot-toast": "^2.6.0",
    "react-is": "^19.3.0",
    "react-router-dom": "^7.13.2",
    "recharts": "^3.8.1",
    "resend": "^6.34.1",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.21.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.21",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.11"
  }
}
