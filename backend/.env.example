PORT=4001
NODE_ENV=production
ALLOWED_ORIGINS=https://click2itbd.com,https://www.click2itbd.com,http://localhost:3000,http://localhost:5173

# WHM / cPanel Credentials
WHM_URL=
WHM_API_URL=
WHM_API_TOKEN=
WHM_USERNAME=root
WHM_API_TYPE=cpanel
WHM_VERIFY_SSL=false
WHM_TIMEOUT_MS=15000

# Openprovider Credentials
OPENPROVIDER_USERNAME=
OPENPROVIDER_PASSWORD=
OPENPROVIDER_SANDBOX_MODE=false
OPENPROVIDER_DEFAULT_HANDLE=

# CloudLinux Credentials
CLOUDLINUX_ENABLED=false
CLOUDLINUX_API_URL=
CLOUDLINUX_API_TOKEN=
CLOUDLINUX_PARTNER_LOGIN=
CLOUDLINUX_SECRET_KEY=

# Resend Transactional Email Configuration
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@click2it.bd

# SMTP Mail Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Click2IT Hosting
SMTP_FROM_EMAIL=noreply@click2it.bd

# Firebase Service Account (JSON string or path to service-account.json)
FIREBASE_SERVICE_ACCOUNT_KEY=
