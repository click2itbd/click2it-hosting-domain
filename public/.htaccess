DirectoryIndex index.html
Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forward /api requests to local Node.js backend on port 4000
  RewriteRule ^/?api/(.*)$ http://127.0.0.1:4000/api/$1 [P,L,QSA,E=Cache-Control:no-cache]
  RewriteRule ^/?api/?$ http://127.0.0.1:4000/api/ [P,L,QSA,E=Cache-Control:no-cache]

  # Route social media crawlers requesting /product/xxx to share.php (ONLY if share.php exists on server)
  RewriteCond %{DOCUMENT_ROOT}/share.php -f
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|WhatsApp|Twitterbot|Pinterest|LinkedInBot|TelegramBot|Slackbot|Discordbot|SkypeUriPreview|Viber|kakaotalk-scrap|vkShare) [NC]
  RewriteRule ^product/([a-zA-Z0-9_.-]+)/?$ /share.php?id=$1 [L,QSA]

  # Direct all other routes to React Single Page App (index.html)
  RewriteRule ^index\.html$ - [L,E=Cache-Control:no-cache]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L,E=Cache-Control:no-cache]
</IfModule>

<IfModule LiteSpeed>
  CacheDisable public /
  CacheDisable private /
</IfModule>

<FilesMatch "^index\.html$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires 0
</FilesMatch>