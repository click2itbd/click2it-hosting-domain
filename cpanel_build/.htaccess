DirectoryIndex index.html
Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  <IfModule mod_proxy.c>
    # Forward /api requests to local Node.js backend on port 4001
    RewriteRule ^/?api/(.*)$ http://127.0.0.1:4001/api/$1 [P,L,QSA,E=Cache-Control:no-cache]
    RewriteRule ^/?api/?$ http://127.0.0.1:4001/api/ [P,L,QSA,E=Cache-Control:no-cache]
  </IfModule>

  # Route social media crawlers requesting /product/xxx to share.php (ONLY if share.php exists on server)
  RewriteCond %{DOCUMENT_ROOT}/share.php -f
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|WhatsApp|Twitterbot|Pinterest|LinkedInBot|TelegramBot|Slackbot|Discordbot|SkypeUriPreview|Viber|kakaotalk-scrap|vkShare) [NC]
  RewriteRule ^product/([a-zA-Z0-9_.-]+)/?$ /share.php?id=$1 [L,QSA]

  # Direct all other routes to React Single Page App (index.html)
  RewriteRule ^index\.html$ - [L,E=Cache-Control:no-cache]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L,E=Cache-Control:no-cache]
</IfModule>

<IfModule mod_headers.c>
  # Disable HTTP/3 QUIC on routes where UDP packets get dropped/truncated
  Header always set Alt-Svc "clear"
</IfModule>

<FilesMatch "\.(js|css|woff2?|ttf|svg|png|jpe?g|webp|ico)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable"
  </IfModule>
</FilesMatch>

<FilesMatch "^index\.html$">
  <IfModule LiteSpeed>
    CacheDisable public /index.html
    CacheDisable private /index.html
  </IfModule>
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </IfModule>
</FilesMatch>